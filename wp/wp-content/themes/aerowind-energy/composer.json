{
    "name": "aerowind/energy-theme",
    "description": "AeroWind Energy - Premium residential wind energy WordPress theme powered by Carbon Fields.",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "htmlburger/carbon-fields": "^3.6"
    },
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
